<Window x:Class="WorkIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkIT.App"
        xmlns:models="clr-namespace:WorkIT.App.Models"
        mc:Ignorable="d"
        Title="WorkIT — Painel de Vagas &amp; Rastreador TI" Height="780" Width="1140"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0d0e17"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Paleta de Cores Moderna (Dark / VS Code / Catppuccin) -->
        <SolidColorBrush x:Key="BgDark" Color="#0d0e17"/>
        <SolidColorBrush x:Key="BgSurface" Color="#151624"/>
        <SolidColorBrush x:Key="BgCard" Color="#1a1c2d"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2a2e47"/>

        <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563eb"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10b981"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8b5cf6"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06b6d4"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#f59e0b"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#f8fafc"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94a3b8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>

        <!-- ========================================== -->
        <!-- SCROLLBAR MINIMALISTA DARK (O "SLIDER")    -->
        <!-- ========================================== -->
        <Style x:Key="MinimalScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#2e334d" CornerRadius="4" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0d0e17">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0d0e17">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================== -->
        <!-- ESTILO COMBOBOX ITEM 100% DARK             -->
        <!-- ========================================== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="#171928" Padding="12,8" CornerRadius="6" Margin="2,1" Cursor="Hand">
                            <ContentPresenter ContentSource="Content" TextElement.Foreground="#e2e8f0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252b45"/>
                                <Setter Property="TextElement.Foreground" Value="#60a5fa"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1d4ed8"/>
                                <Setter Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- ESTILO COMBOBOX COM POPUP DARK             -->
        <!-- ========================================== -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="34" Width="34"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="7" Background="#191b2c" BorderBrush="#2e334d" BorderThickness="1">
                                            <Grid>
                                                <Border x:Name="ArrowBorder" HorizontalAlignment="Right" Width="34">
                                                    <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 4.5 4.5 L 9 0 Z" Fill="#94a3b8"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569"/>
                                                <Setter TargetName="Border" Property="Background" Value="#202338"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#f8fafc"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#3b82f6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Texto Selecionado -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#f8fafc"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!-- Dropdown Popup 100% Dark -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide" VerticalOffset="4">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder" Background="#141524" BorderBrush="#323753"
                                            BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- ESTILO TEXTBOX DARK                        -->
        <!-- ========================================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#191b2c"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="CaretBrush" Value="#3b82f6"/>
            <Setter Property="BorderBrush" Value="#2e334d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter TargetName="Border" Property="Background" Value="#1c1f33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================== -->
        <!-- BOTÕES                                     -->
        <!-- ========================================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563eb" Offset="0"/>
                                    <GradientStop Color="#1d4ed8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3b82f6" Offset="0"/>
                                            <GradientStop Color="#2563eb" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#191b2c"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderBrush" Value="#2e334d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#25283f"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Background" Value="#252a42"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================================== -->
        <!-- ESTILO TABCONTROL & TABITEM (AMBOS OS LADOS REDONDOS)    -->
        <!-- ======================================================== -->
        <Style TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barra de Navegação Horizontal sem interferência do TabPanel legado -->
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,14"/>

                            <!-- Conteúdo da Aba Ativa -->
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- CornerRadius 8 garante cantos 100% arredondados à esquerda e à direita -->
                        <Border x:Name="TabBorder" Background="#161828" BorderBrush="#25293d" BorderThickness="1" CornerRadius="8" Padding="20,10">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563eb"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#20243b"/>
                                <Setter Property="Foreground" Value="#f1f5f9"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content (Tabs) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. CABEÇALHO SUPERIOR -->
        <Border Grid.Row="0" Background="#12131f" BorderBrush="#1f2235" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Identidade -->
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563eb" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WorkIT" FontSize="22" FontWeight="ExtraBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                        <Border Background="#1f233a" BorderBrush="#313754" BorderThickness="1" CornerRadius="5" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 • C# / .NET 10" FontSize="11" FontWeight="SemiBold" Foreground="#93c5fd"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Painel do Desenvolvedor — Rastreador e Centralizador de Vagas de TI" FontSize="12" Foreground="#94a3b8" Margin="46,2,0,0"/>
                </StackPanel>

                <!-- Cards Métricas Rápidas no Topo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Chip Total Encontradas -->
                    <Border Background="#162035" BorderBrush="#2563eb" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Encontradas: " FontSize="12" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtTotalEncontradas" Text="0" FontWeight="Bold" FontSize="13" Foreground="#60a5fa"/>
                        </StackPanel>
                    </Border>
                    <!-- Chip Novas -->
                    <Border Background="#122c22" BorderBrush="#10b981" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨ Novas: " FontSize="12" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtTotalNovas" Text="0" FontWeight="Bold" FontSize="13" Foreground="#34d399"/>
                        </StackPanel>
                    </Border>
                    <!-- Chip Já Vistas -->
                    <Border Background="#1c202d" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️ Já Vistas: " FontSize="12" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtTotalJaVistas" Text="0" FontWeight="Bold" FontSize="13" Foreground="#cbd5e1"/>
                        </StackPanel>
                    </Border>
                    <!-- Chip Banco Local -->
                    <Border Background="#241738" BorderBrush="#8b5cf6" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 No Banco: " FontSize="12" Foreground="#94a3b8"/>
                            <TextBlock x:Name="TxtTotalBanco" Text="0" FontWeight="Bold" FontSize="13" Foreground="#c084fc"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BARRA DE FILTROS -->
        <Border Grid.Row="1" Background="#141524" BorderBrush="#1f2235" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*"/> <!-- Área -->
                        <ColumnDefinition Width="1.5*"/> <!-- Estado -->
                        <ColumnDefinition Width="1.8*"/> <!-- Cidade -->
                        <ColumnDefinition Width="2.0*"/> <!-- Palavra-chave extra -->
                        <ColumnDefinition Width="Auto"/> <!-- Botão Buscar -->
                        <ColumnDefinition Width="Auto"/> <!-- Botão CSV -->
                    </Grid.ColumnDefinitions>

                    <!-- Filtro Área -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Área de TI:" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbArea" DisplayMemberPath="Nome"/>
                    </StackPanel>

                    <!-- Filtro Estado -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Estado (UF):" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbEstado" DisplayMemberPath="Display"/>
                    </StackPanel>

                    <!-- Filtro Cidade -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Cidade (opcional):" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCidade" Text="" KeyDown="Input_KeyDown"/>
                    </StackPanel>

                    <!-- Filtro Palavra Extra -->
                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <TextBlock Text="Palavra-chave adicional:" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtTermoExtra" Text="" KeyDown="Input_KeyDown"/>
                    </StackPanel>

                    <!-- Botão Buscar -->
                    <Button x:Name="BtnBuscar" Grid.Column="4" Style="{StaticResource PrimaryButton}" Margin="0,20,10,0" Click="BtnBuscar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="12"/>
                            <TextBlock Text="Buscar Vagas"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Exportar CSV -->
                    <Button x:Name="BtnExportar" Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0" Click="BtnExportar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥 " FontSize="12"/>
                            <TextBlock Text="Exportar CSV"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Barra de Carregamento Indeterminada -->
                <ProgressBar x:Name="ProgressBusca" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0" Background="#191b2c" Foreground="#3b82f6" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- 3. ABAS DE CONTEÚDO PRINCIPAL -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="24,14,24,12">

            <!-- ABA 1: OPORTUNIDADES ENCONTRADAS -->
            <TabItem Header="Oportunidades Encontradas">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Text -->
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock x:Name="TxtStatusLista" Text="Nenhuma busca realizada ainda." FontSize="13" Foreground="#94a3b8"/>
                    </Grid>

                    <!-- Empty State amigável quando ainda não buscou nada -->
                    <Border x:Name="EmptyStatePlaceholder" Grid.Row="1" Background="#131522" BorderBrush="#202438" BorderThickness="1" CornerRadius="12" Padding="40,35" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#1e253e" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="💼" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pronto para encontrar sua próxima vaga?" FontSize="18" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecione sua área de interesse (Frontend, Backend, RPA, etc.), escolha o estado ou digite uma cidade nos filtros acima e clique em 'Buscar Vagas'." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap" LineHeight="19" TextAlignment="Center" Margin="0,0,0,20"/>

                            <!-- Destaques -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Background="#191d30" BorderBrush="#2c3454" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                                    <TextBlock Text="⚡ API Pública da Gupy" FontSize="11" Foreground="#93c5fd"/>
                                </Border>
                                <Border Background="#191d30" BorderBrush="#2c3454" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                                    <TextBlock Text="🏷️ Classificação Automática" FontSize="11" Foreground="#93c5fd"/>
                                </Border>
                                <Border Background="#191d30" BorderBrush="#2c3454" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                                    <TextBlock Text="💾 SQLite Idempotente" FontSize="11" Foreground="#93c5fd"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Cards de Vagas (Com ScrollBar Minimalista Dark) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsVagas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Vaga}">
                                    <Border Background="#161828" BorderBrush="#25293d" BorderThickness="1" CornerRadius="10" Margin="0,0,10,12" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Informações da Vaga -->
                                            <StackPanel Grid.Column="0">
                                                <!-- Badges de Status e Nível -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <!-- Badge Nova vs Já Vista -->
                                                    <Border Background="{Binding BadgeCor}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <!-- Badge Nível -->
                                                    <Border Background="{Binding NivelBadgeCor}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Nivel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <!-- ID da vaga -->
                                                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Título da Vaga -->
                                                <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="Bold" Foreground="#f8fafc" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <!-- Empresa e Local -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🏢 " FontSize="12"/>
                                                    <TextBlock Text="{Binding Empresa}" FontSize="13" FontWeight="SemiBold" Foreground="#93c5fd" Margin="0,0,16,0"/>
                                                    <TextBlock Text="📍 " FontSize="12"/>
                                                    <TextBlock Text="{Binding LocalFormatado}" FontSize="13" Foreground="#cbd5e1"/>
                                                </StackPanel>

                                                <!-- Data Publicação -->
                                                <TextBlock Text="{Binding DataPublicacao, StringFormat='Publicado em: {0}'}" FontSize="11" Foreground="#64748b"/>
                                            </StackPanel>

                                            <!-- Ações no Card -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Style="{StaticResource CardActionButton}" Tag="{Binding}" Click="BtnAbrirLink_Click" Margin="0,0,0,8" MinWidth="155">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🌐 " FontSize="12"/>
                                                        <TextBlock Text="Abrir no Navegador"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource CardActionButton}" Tag="{Binding}" Click="BtnFavoritar_Click" MinWidth="155">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="⭐ Salvar Vaga"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Favorita}" Value="True">
                                                                            <Setter Property="Text" Value="★ Vaga Salva"/>
                                                                            <Setter Property="Foreground" Value="#fbbf24"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ABA 2: VAGAS FAVORITAS / SALVAS -->
            <TabItem Header="⭐ Vagas Salvas">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Oportunidades salvas no banco de dados local SQLite para acompanhamento:" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="🔄 Atualizar Salvas" Click="BtnRecarregarFavoritas_Click"/>
                    </Grid>

                    <!-- Empty State amigável quando não há favoritos salvos -->
                    <Border x:Name="EmptyStateFavoritas" Grid.Row="1" Background="#131522" BorderBrush="#202438" BorderThickness="1" CornerRadius="12" Padding="40,35" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#241e36" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="⭐" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhuma vaga favoritada ainda" FontSize="17" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pesquise oportunidades na primeira aba e clique no botão '⭐ Salvar Vaga' para acompanhar suas vagas preferidas aqui." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap" LineHeight="19" TextAlignment="Center" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsFavoritas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Vaga}">
                                    <Border Background="#161828" BorderBrush="#25293d" BorderThickness="1" CornerRadius="10" Margin="0,0,10,12" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="{Binding NivelBadgeCor}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Nivel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,6"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏢 " FontSize="12"/>
                                                    <TextBlock Text="{Binding Empresa}" FontSize="12" FontWeight="SemiBold" Foreground="#93c5fd" Margin="0,0,14,0"/>
                                                    <TextBlock Text="📍 " FontSize="12"/>
                                                    <TextBlock Text="{Binding LocalFormatado}" FontSize="12" Foreground="#cbd5e1"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource CardActionButton}" Tag="{Binding}" Click="BtnAbrirLink_Click" Margin="0,0,8,0" Padding="14,8">
                                                    <TextBlock Text="🌐 Abrir Vaga"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButton}" Tag="{Binding}" Click="BtnRemoverFavorita_Click" Padding="12,8" Background="#881337">
                                                    <TextBlock Text="🗑️ Remover"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ABA 3: ESTATÍSTICAS DO MERCADO -->
            <TabItem Header="📊 Estatísticas &amp; Sobre">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Grid de Cards de Métricas -->
                        <TextBlock Text="Métricas do Banco Local de Vagas (SQLite)" FontSize="16" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,14"/>

                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <!-- Card Estágio -->
                            <Border Background="#161828" BorderBrush="#8b5cf6" BorderThickness="1" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Estágio" FontSize="13" Foreground="#c084fc"/>
                                    <TextBlock x:Name="TxtQtdEstagio" Text="0" FontSize="28" FontWeight="Bold" Foreground="#f8fafc" Margin="0,4,0,0"/>
                                    <TextBlock Text="vagas catalogadas" FontSize="11" Foreground="#94a3b8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card Júnior -->
                            <Border Background="#161828" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Júnior" FontSize="13" Foreground="#60a5fa"/>
                                    <TextBlock x:Name="TxtQtdJunior" Text="0" FontSize="28" FontWeight="Bold" Foreground="#f8fafc" Margin="0,4,0,0"/>
                                    <TextBlock Text="vagas catalogadas" FontSize="11" Foreground="#94a3b8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card Pleno -->
                            <Border Background="#161828" BorderBrush="#06b6d4" BorderThickness="1" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Pleno" FontSize="13" Foreground="#22d3ee"/>
                                    <TextBlock x:Name="TxtQtdPleno" Text="0" FontSize="28" FontWeight="Bold" Foreground="#f8fafc" Margin="0,4,0,0"/>
                                    <TextBlock Text="vagas catalogadas" FontSize="11" Foreground="#94a3b8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card Sênior -->
                            <Border Background="#161828" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Sênior" FontSize="13" Foreground="#fbbf24"/>
                                    <TextBlock x:Name="TxtQtdSenior" Text="0" FontSize="28" FontWeight="Bold" Foreground="#f8fafc" Margin="0,4,0,0"/>
                                    <TextBlock Text="vagas catalogadas" FontSize="11" Foreground="#94a3b8"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Informações do Trabalho e da Arquitetura -->
                        <Border Background="#161828" BorderBrush="#25293d" BorderThickness="1" CornerRadius="10" Padding="22" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Visão Geral da Arquitetura do Projeto (Para Defesa)" FontSize="15" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,12"/>

                                <TextBlock Text="• Back-end em C# (.NET): Estrutura em camadas (Models, Services, Data) orientada a objetos." FontSize="13" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                                <TextBlock Text="• Consumo de API REST Externa: Integração com o portal público da Gupy via HttpClient assíncrono com paginação." FontSize="13" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                                <TextBlock Text="• Banco Local SQLite: Persistência local (vagas.db) com idempotência através de INSERT OR IGNORE para detecção de novidades." FontSize="13" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                                <TextBlock Text="• Classificador Inteligente de Senioridade: Detecção automática por análise textual e normalização Unicode de acentos." FontSize="13" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                                <TextBlock Text="• Interface Gráfica Moderna (WPF): Janela responsiva com navegação em abas, tema escuro nativo e feedback visual instantâneo." FontSize="13" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                                <TextBlock Text="• Exportação de Relatórios: Geração de arquivos CSV com encoding UTF-8 com BOM para visualização direta no Excel." FontSize="13" Foreground="#cbd5e1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. BARRA DE STATUS INFERIOR -->
        <Border Grid.Row="3" Background="#10111d" BorderBrush="#1f2235" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStatusRodape" Text="Pronto para realizar buscas de vagas." FontSize="12" Foreground="#94a3b8"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Desenvolvimento de Software Visual — WorkIT" FontSize="11" Foreground="#64748b"/>
            </Grid>
        </Border>
    </Grid>
</Window>
